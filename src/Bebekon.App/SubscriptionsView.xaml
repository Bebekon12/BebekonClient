<UserControl x:Class="Bebekon.App.SubscriptionsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Bebekon.App">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="{DynamicResource Subscriptions}" Style="{StaticResource Heading}"/><TextBlock Text="{DynamicResource SubscriptionDetail}" Style="{StaticResource Subtitle}" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Command="{Binding AddSubscription}" Style="{StaticResource AccentButton}" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><local:IconView Icon="Plus" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="{DynamicResource AddSubscription}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="14" FontWeight="SemiBold"/></StackPanel></Button></Grid>
  <Grid Grid.Row="1" Margin="0,0,0,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBox Text="{Binding QuickSource, UpdateSourceTrigger=PropertyChanged}" Tag="{DynamicResource SubscriptionLink}" AutomationProperties.Name="{DynamicResource SubscriptionLink}" Height="46"/><Button Grid.Row="1" Command="{Binding ImportQuickSubscription}" Style="{StaticResource AccentButton}" Margin="0,12,0,0" Height="44"><Button.Content><StackPanel Orientation="Horizontal"><local:IconView Icon="Plus" Width="17" Height="17" Margin="0,0,8,0"/><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{DynamicResource ImportLink}"/><Style.Triggers><DataTrigger Binding="{Binding Importing}" Value="True"><Setter Property="Text" Value="{DynamicResource ImportingLink}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Button.Content></Button><TextBlock Grid.Row="2" Text="{DynamicResource SubscriptionFormats}" Style="{StaticResource Subtitle}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/></Grid><ListBox Grid.Row="2" ItemsSource="{Binding Data.Subscriptions}"><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource CardStyle}" BorderBrush="{DynamicResource AccentBorder}" Padding="18"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Style="{StaticResource IconBadge}"><local:IconView Icon="Subscription" Foreground="{DynamicResource Accent}"/></Border><StackPanel Grid.Column="1" Margin="14,0,14,0"><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding SafeSource}" Style="{StaticResource Subtitle}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><Border Grid.Column="2" Background="{DynamicResource AccentSoft}" CornerRadius="9" Padding="10,6" VerticalAlignment="Top"><TextBlock Text="{Binding ServerCount}" FontSize="12" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" ToolTip="{DynamicResource SubscriptionCount}"/></Border></Grid><TextBlock Text="{Binding Summary}" Style="{StaticResource Subtitle}" FontSize="12" Margin="54,8,0,0"/><Border Height="1" Background="{DynamicResource Border}" Margin="0,18,0,14"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button Content="{DynamicResource Update}" Command="{Binding DataContext.RefreshSubscription, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,8,0"/><Button Content="{DynamicResource Edit}" Command="{Binding DataContext.EditSubscription, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></StackPanel><Button Grid.Column="1" Command="{Binding DataContext.DeleteSubscription, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource QuietIconButton}" ToolTip="{DynamicResource Delete}"><local:IconView Icon="Trash" Width="17" Height="17"/></Button></Grid></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
  <Border Grid.Row="2" Visibility="{Binding NoSubscriptions}" VerticalAlignment="Center" Style="{StaticResource CardStyle}" Padding="36"><StackPanel><Border Style="{StaticResource IconBadge}" Width="56" Height="56"><local:IconView Icon="Subscription" Width="27" Height="27" Foreground="{DynamicResource Accent}"/></Border><TextBlock Text="{DynamicResource NoSubscriptions}" HorizontalAlignment="Center" FontSize="21" Margin="0,20,0,8"/><TextBlock Text="{DynamicResource NoServersDetail}" HorizontalAlignment="Center" Style="{StaticResource Subtitle}"/><Button Content="{DynamicResource AddSubscription}" Command="{Binding AddSubscription}" Style="{StaticResource AccentButton}" HorizontalAlignment="Center" Margin="0,22,0,0"/></StackPanel></Border>
 </Grid>
</UserControl>
