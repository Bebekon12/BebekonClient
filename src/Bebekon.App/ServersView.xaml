<UserControl x:Class="Bebekon.App.ServersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Bebekon.App">
<UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ServerTemplates.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,22" Visibility="{Binding Embedded, RelativeSource={RelativeSource AncestorType=local:ServersView}, Converter={StaticResource InverseBoolVisibility}}"><TextBlock Text="{DynamicResource ServerTitle}" Style="{StaticResource Heading}"/><TextBlock Text="{DynamicResource ServerSubtitle}" Style="{StaticResource Subtitle}"/></StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBox x:Name="ServerSearchBox" Tag="{DynamicResource SearchServers}" Text="{Binding ServerSearch, UpdateSourceTrigger=PropertyChanged}" Height="46"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource SearchBox}"><Setter Property="Margin" Value="0,0,8,0"/><Style.Triggers><DataTrigger Binding="{Binding Compact, RelativeSource={RelativeSource AncestorType=local:ServersView}}" Value="True"><Setter Property="Grid.ColumnSpan" Value="2"/><Setter Property="Margin" Value="0,0,0,10"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
   <Grid Height="46"><Grid.Style><Style TargetType="Grid"><Setter Property="Grid.Column" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding Compact, RelativeSource={RelativeSource AncestorType=local:ServersView}}" Value="True"><Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/><Setter Property="HorizontalAlignment" Value="Left"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="252"/><ColumnDefinition Width="52"/><ColumnDefinition Width="52"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
   <ComboBox SelectedIndex="{Binding SortIndex}" Margin="0,0,8,0"><ComboBoxItem Content="{DynamicResource ByLatency}"/><ComboBoxItem Content="{DynamicResource ByName}"/></ComboBox>
   <ComboBox x:Name="LatencyMethod" ToolTip="{DynamicResource LatencyHelp}" Grid.Column="1" SelectedIndex="{Binding LatencyIndex}" Margin="0,0,8,0"><ComboBoxItem Content="{DynamicResource Tcp}"/><ComboBoxItem Content="{DynamicResource HttpsGet}"/><ComboBoxItem Content="{DynamicResource HttpsHead}"/><ComboBoxItem Content="{DynamicResource Icmp}"/></ComboBox>
   <CheckBox Grid.Column="2" IsChecked="{Binding ListMode}" Style="{StaticResource ViewModeButton}" ToolTip="{DynamicResource ViewMode}" Width="46" Height="46" HorizontalAlignment="Left"/>
   <Button Grid.Column="3" Visibility="{Binding Scanning, Converter={StaticResource InverseBoolVisibility}}" Command="{Binding PingAll}" ToolTip="{DynamicResource PingAll}" Style="{StaticResource IconButton}" Width="46" Height="46" HorizontalAlignment="Left"><local:IconView Icon="Bolt" Width="18" Height="18"/></Button>
   <Button Grid.Column="3" Visibility="{Binding Scanning, Converter={StaticResource BoolVisibility}}" Command="{Binding CancelPing}" ToolTip="{DynamicResource Cancel}" Style="{StaticResource IconButton}" Width="46" Height="46" HorizontalAlignment="Left"><local:IconView Icon="Close" Width="18" Height="18"/></Button>
   <Button Grid.Column="4" Command="{Binding RefreshSubscriptions}" ToolTip="{DynamicResource Update}" Style="{StaticResource IconButton}" Width="46" Height="46"><local:IconView Icon="Refresh" Width="18" Height="18"/></Button>
   </Grid>
  </Grid>
  <Grid Grid.Row="2" Margin="16,0,16,9" Visibility="{Binding ListMode, Converter={StaticResource BoolVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="132"/><ColumnDefinition Width="84"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource ServerColumn}" Style="{StaticResource Eyebrow}" Margin="42,0,0,0"/><TextBlock Grid.Column="1" Text="{DynamicResource ProtocolColumn}" Style="{StaticResource Eyebrow}"/><TextBlock Grid.Column="2" Text="{DynamicResource LatencyColumn}" Style="{StaticResource Eyebrow}" HorizontalAlignment="Center"/><local:IconView Grid.Column="3" Icon="Star" Width="12" Height="12" Foreground="{DynamicResource Muted}"/></Grid>
  <ListBox x:Name="ServerList" Grid.Row="3" ItemsSource="{Binding ServerRows}" Visibility="{Binding ToolbarOnly, RelativeSource={RelativeSource AncestorType=local:ServersView}, Converter={StaticResource InverseBoolVisibility}}"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Margin" Value="0,0,0,6"/></Style></ListBox.ItemContainerStyle></ListBox>
  <Border Grid.Row="3" VerticalAlignment="Center" Padding="26"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource CardStyle}"><Setter Property="Visibility" Value="{Binding NoServers}"/><Style.Triggers><DataTrigger Binding="{Binding ToolbarOnly, RelativeSource={RelativeSource AncestorType=local:ServersView}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><local:IconView Icon="Servers" Width="32" Height="32" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/><TextBlock Text="{DynamicResource NoServers}" FontSize="20" HorizontalAlignment="Center" Margin="0,15,0,8"/><TextBlock Text="{DynamicResource NoServersDetail}" Style="{StaticResource Subtitle}" HorizontalAlignment="Center" TextWrapping="Wrap"/><Button Content="{DynamicResource AddSubscription}" Command="{Binding AddSubscription}" Style="{StaticResource AccentButton}" HorizontalAlignment="Center" Margin="0,18,0,0"/></StackPanel></Border>
  <Border Grid.Row="1" Height="2" VerticalAlignment="Bottom" Visibility="{Binding Scanning, Converter={StaticResource BoolVisibility}}" Background="{DynamicResource Accent}" Opacity="0.4" CornerRadius="1"/>
 </Grid>
</UserControl>
