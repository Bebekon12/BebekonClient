<UserControl x:Class="Bebekon.App.ServersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Bebekon.App">
 <UserControl.Resources><local:SelectionConverter x:Key="Selection"/>
  <DataTemplate x:Key="ServerCard">
   <Border x:Name="ServerSurface" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="16" MinHeight="72"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource Card}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource CardHover}"/></Trigger></Style.Triggers></Style></Border.Style><Grid>
    <Button Command="{Binding DataContext.SelectServer, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Padding="15,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="58"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions><local:FlagView Country="{Binding Name}" Width="32" Height="23" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Margin="12,0,4,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/><TextBlock x:Name="ProtocolLabel" Text="{Binding Protocol}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Latency}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11"/></Grid></Button>
    <Button Command="{Binding DataContext.FavoriteServer, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0" ToolTip="Избранное"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuietIconButton}"><Style.Triggers><DataTrigger Binding="{Binding Favorite}" Value="True"><Setter Property="Foreground" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style><local:IconView Icon="Star" Width="17" Height="17"/></Button>
   </Grid><Border.ToolTip><TextBlock Text="{Binding UnsupportedReason}"/></Border.ToolTip></Border>
   <DataTemplate.Triggers><DataTrigger Value="True"><DataTrigger.Binding><MultiBinding Converter="{StaticResource Selection}"><Binding/><Binding Path="DataContext.SelectedServer" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></DataTrigger.Binding><Setter TargetName="ServerSurface" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="ServerSurface" Property="Background" Value="{StaticResource AccentSoft}"/></DataTrigger><DataTrigger Binding="{Binding Supported}" Value="False"><Setter TargetName="ServerSurface" Property="Opacity" Value="0.65"/><Setter TargetName="ProtocolLabel" Property="Text" Value="{DynamicResource Unsupported}"/><Setter TargetName="ProtocolLabel" Property="Foreground" Value="{StaticResource Warning}"/></DataTrigger></DataTemplate.Triggers>
  </DataTemplate>
 </UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,24"><TextBlock Text="{DynamicResource ServerTitle}" Style="{StaticResource Heading}"/><TextBlock Text="{DynamicResource ServerSubtitle}" Style="{StaticResource Subtitle}"/></StackPanel>
  <Grid Grid.Row="1" Height="46" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="124"/><ColumnDefinition Width="136"/><ColumnDefinition Width="46"/><ColumnDefinition Width="46"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
   <TextBox Tag="{DynamicResource SearchServers}" Text="{Binding ServerSearch, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" Margin="0,0,10,0"/>
   <ComboBox Grid.Column="1" SelectedIndex="{Binding SortIndex}" Margin="0,0,10,0"><ComboBoxItem Content="{DynamicResource ByLatency}"/><ComboBoxItem Content="{DynamicResource ByName}"/></ComboBox>
   <ComboBox Grid.Column="2" SelectedIndex="{Binding LatencyIndex}" Margin="0,0,10,0"><ComboBoxItem Content="{DynamicResource Fast}"/><ComboBoxItem Content="{DynamicResource Exact}"/></ComboBox>
   <CheckBox Grid.Column="3" IsChecked="{Binding ListMode}" Style="{StaticResource ViewModeButton}" ToolTip="{DynamicResource ViewMode}" Width="40" Height="46" HorizontalAlignment="Left"/>
   <Button Grid.Column="4" Command="{Binding PingAll}" ToolTip="{DynamicResource PingAll}" Style="{StaticResource IconButton}" Height="46" HorizontalAlignment="Left"><local:IconView Icon="Bolt" Width="18" Height="18"/></Button>
   <Button Grid.Column="5" Command="{Binding RefreshSubscriptions}" ToolTip="{DynamicResource Update}" Style="{StaticResource IconButton}" Height="46"><local:IconView Icon="Refresh" Width="18" Height="18"/></Button>
  </Grid>
  <ListBox Grid.Row="2" ItemsSource="{Binding ServerRows}"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="{Binding DataContext.SecondColumn, RelativeSource={RelativeSource AncestorType=UserControl}}"/></Grid.ColumnDefinitions><ContentControl Content="{Binding Left}" ContentTemplate="{StaticResource ServerCard}" Margin="0,0,7,0"/><ContentControl Grid.Column="1" Content="{Binding Right}" ContentTemplate="{StaticResource ServerCard}" Margin="7,0,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
  <Border Grid.Row="2" Visibility="{Binding NoServers}" VerticalAlignment="Center" Style="{StaticResource CardStyle}" Padding="36"><StackPanel><local:IconView Icon="Servers" Width="38" Height="38" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/><TextBlock Text="{DynamicResource NoServers}" FontSize="21" HorizontalAlignment="Center" Margin="0,18,0,8"/><TextBlock Text="{DynamicResource NoServersDetail}" Style="{StaticResource Subtitle}" HorizontalAlignment="Center"/><Button Content="{DynamicResource AddSubscription}" Command="{Binding AddSubscription}" Style="{StaticResource AccentButton}" HorizontalAlignment="Center" Margin="0,22,0,0"/></StackPanel></Border>
  <ProgressBar Grid.Row="1" Height="2" VerticalAlignment="Bottom" IsIndeterminate="{Binding Scanning}" Visibility="{Binding Scanning, Converter={StaticResource BoolVisibility}}" Foreground="{StaticResource Accent}" Background="Transparent"/>
 </Grid>
</UserControl>
