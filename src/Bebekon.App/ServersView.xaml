<UserControl x:Class="Bebekon.App.ServersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Bebekon.App">
<UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ServerTemplates.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,22" Visibility="{Binding Embedded, RelativeSource={RelativeSource AncestorType=local:ServersView}, Converter={StaticResource InverseBoolVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource ServerTitle}" Style="{StaticResource Heading}"/><TextBlock Text="{DynamicResource ServerSubtitle}" Style="{StaticResource Subtitle}"/></StackPanel><Button Grid.Column="1" Command="{Binding AddTrustTunnel}" Content="TrustTunnel · вручную" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid>
  <StackPanel Grid.Row="1" Margin="0,0,0,10">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox x:Name="ServerSearchBox" Tag="{DynamicResource SearchServers}" Text="{Binding ServerSearch, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" Margin="0,0,8,0"/>
    <ComboBox Grid.Column="1" Width="124" SelectedIndex="{Binding SortIndex}" Margin="0,0,8,0"><ComboBoxItem Content="{DynamicResource ByLatency}"/><ComboBoxItem Content="{DynamicResource ByName}"/></ComboBox>
    <CheckBox Grid.Column="2" IsChecked="{Binding ListMode}" Style="{StaticResource ViewModeButton}" ToolTip="{DynamicResource ViewMode}" Width="46" Height="46" Margin="0,0,8,0"/>
    <Button Grid.Column="3" Command="{Binding RefreshSubscriptions}" ToolTip="{DynamicResource Update}" AutomationProperties.Name="{DynamicResource Update}" Style="{StaticResource IconButton}" Width="46" Height="46"><local:IconView Icon="Refresh" Width="18" Height="18"/></Button>
   </Grid>
   <Border Style="{StaticResource CardStyle}" Padding="10,7" Margin="0,8,0,0"><StackPanel>
    <WrapPanel VerticalAlignment="Center">
     <ComboBox x:Name="LatencyMethod" AutomationProperties.Name="{DynamicResource ScanMethod}" ToolTip="{DynamicResource LatencyHelp}" SelectedIndex="{Binding LatencyIndex}" Width="150" Margin="0,0,8,0"><ComboBoxItem Content="{DynamicResource Tcp}"/><ComboBoxItem Content="{DynamicResource HttpsGet}"/><ComboBoxItem Content="{DynamicResource HttpsHead}"/><ComboBoxItem Content="{DynamicResource Icmp}"/></ComboBox>
     <Button Command="{Binding PingAll}" Content="{DynamicResource ScanServers}" Style="{StaticResource AccentButton}" Margin="0,0,8,0"/>
     <Button Command="{Binding CancelPing}" Content="{DynamicResource ScanStop}" Margin="0,0,8,0"/>
     <CheckBox IsChecked="{Binding AutoServerEnabled}" Content="{DynamicResource AutoServer}" Style="{StaticResource AutoServerButton}" ToolTip="{DynamicResource AutoServerHelp}" Width="78" Height="40"/>
    </WrapPanel>
    <TextBlock Text="{Binding ScanSummary}" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Subtitle}"><Setter Property="Margin" Value="2,6,0,0"/><Style.Triggers><DataTrigger Binding="{Binding ScanSummary}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <ProgressBar Height="3" Margin="1,5,1,0" Foreground="{DynamicResource Accent}" Background="{DynamicResource CardHover}" Maximum="{Binding ScanTotal, Mode=OneWay}" Value="{Binding ScanCompleted, Mode=OneWay}" Visibility="{Binding Scanning, Converter={StaticResource BoolVisibility}}"/>
   </StackPanel></Border>
  </StackPanel>
  <Grid Grid.Row="2" Margin="16,0,16,9" Visibility="{Binding ListMode, Converter={StaticResource BoolVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="132"/><ColumnDefinition Width="84"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource ServerColumn}" Style="{StaticResource Eyebrow}" Margin="42,0,0,0"/><TextBlock Grid.Column="1" Text="{DynamicResource ProtocolColumn}" Style="{StaticResource Eyebrow}"/><TextBlock Grid.Column="2" Text="{DynamicResource LatencyColumn}" Style="{StaticResource Eyebrow}" HorizontalAlignment="Center"/><local:IconView Grid.Column="3" Icon="Star" Width="12" Height="12" Foreground="{DynamicResource Muted}"/></Grid>
  <ListBox x:Name="ServerList" Grid.Row="3" ItemsSource="{Binding ServerRows}" Visibility="{Binding ToolbarOnly, RelativeSource={RelativeSource AncestorType=local:ServersView}, Converter={StaticResource InverseBoolVisibility}}"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Margin" Value="0,0,0,6"/></Style></ListBox.ItemContainerStyle></ListBox>
  <Border Grid.Row="3" VerticalAlignment="Center" Padding="26"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource CardStyle}"><Setter Property="Visibility" Value="{Binding NoServers}"/><Style.Triggers><DataTrigger Binding="{Binding ToolbarOnly, RelativeSource={RelativeSource AncestorType=local:ServersView}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><local:IconView Icon="Servers" Width="32" Height="32" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/><TextBlock Text="{DynamicResource NoServers}" FontSize="20" HorizontalAlignment="Center" Margin="0,15,0,8"/><TextBlock Text="{DynamicResource NoServersDetail}" Style="{StaticResource Subtitle}" HorizontalAlignment="Center" TextWrapping="Wrap"/><Button Content="{DynamicResource AddSubscription}" Command="{Binding AddSubscription}" Style="{StaticResource AccentButton}" HorizontalAlignment="Center" Margin="0,18,0,0"/></StackPanel></Border>
 </Grid>
</UserControl>
