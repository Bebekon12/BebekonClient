<Window x:Class="Bebekon.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Bebekon.App" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Bebekon VPN" Width="1160" Height="840" MinWidth="860" MinHeight="660" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource Background}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
 <Grid x:Name="WindowSurface" Background="{DynamicResource Background}">
 <Grid x:Name="AppSurface"><Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding UpdateOverlayOpen}" Value="True"><Setter Property="IsEnabled" Value="False"/><Setter Property="Effect"><Setter.Value><BlurEffect Radius="5" RenderingBias="Performance"/></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></Grid.Style>
  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border x:Name="SidebarHost" Width="200" ClipToBounds="True" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
   <Grid Margin="10,22,10,14"><Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition/><RowDefinition Height="64"/></Grid.RowDefinitions>
    <Grid Margin="0" VerticalAlignment="Top"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Grid Width="54" Height="60"><Ellipse x:Name="LogoHalo" Width="68" Height="68" Margin="-7,-4,-7,-4" Fill="{DynamicResource Halo}" Opacity="0.35" IsHitTestVisible="False" Visibility="{Binding GlowEnabled, Converter={StaticResource BoolVisibility}}"/><Image x:Name="BrandLogo" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality"><Image.Source><BitmapImage UriSource="/Bebekon.App;component/resources/snowman.png" DecodePixelWidth="144"/></Image.Source></Image></Grid>
     <StackPanel Grid.Column="1" Margin="5,3,0,0" VerticalAlignment="Center" Visibility="{Binding NavTextVisibility}"><TextBlock Text="Bebekon" FontSize="18" FontWeight="Bold"/><TextBlock Text="VPN" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,1,0,0"/></StackPanel>
    </Grid>
    <Viewbox Grid.Row="1" Height="172" Margin="-10,0,-10,18" VerticalAlignment="Bottom" IsHitTestVisible="False" Opacity="0.55" Visibility="{Binding NavTextVisibility}"><Canvas Width="200" Height="160"><Path Fill="#12263F" Data="M0,92 L35,50 L55,74 L97,15 L128,58 L154,40 L200,99 V160 H0 Z"/><Path Fill="#1D3553" Data="M35,50 L42,81 L55,74 L97,15 L101,61 L114,55 L128,58 L154,40 L142,91 L172,71 L200,99 L148,114 L105,99 L53,120 L0,114 V92 Z"/><Path Fill="#35547A" Data="M72,51 L97,15 L114,45 L102,37 L96,46 L94,29 L83,47 Z M141,58 L154,40 L172,71 L157,61 L154,48 L148,61 Z"/><Path Fill="#0B182B" Data="M0,123 L8,92 L16,123 L13,123 L23,142 H2 Z M29,144 L40,94 L52,144 H47 L59,160 H25 Z M157,139 L167,93 L179,139 H175 L189,160 H150 Z M181,119 L190,80 L200,119 V160 H180 L187,136 Z"/><Path Stroke="#2C5890" StrokeThickness="2" Data="M200,125 C139,113 126,130 159,140 C181,148 154,151 96,158"/></Canvas></Viewbox>
    <StackPanel Grid.Row="1" Margin="0,9,0,0">
     <Button Command="{Binding Navigate}" CommandParameter="Home" ToolTip="{DynamicResource Home}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding PageName}" Value="Home"><Setter Property="Tag" Value="Active"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><local:IconView Icon="Home" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource Home}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="14,0,0,0" FontSize="14" FontWeight="SemiBold" Visibility="{Binding NavTextVisibility}"/></StackPanel></Button>
     <Button Command="{Binding Navigate}" CommandParameter="Servers" ToolTip="{DynamicResource Servers}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding PageName}" Value="Servers"><Setter Property="Tag" Value="Active"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><local:IconView Icon="Servers" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource Servers}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="14,0,0,0" FontSize="14" FontWeight="SemiBold" Visibility="{Binding NavTextVisibility}"/></StackPanel></Button>
     <Button Command="{Binding Navigate}" CommandParameter="Rules" ToolTip="{DynamicResource Rules}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding PageName}" Value="Rules"><Setter Property="Tag" Value="Active"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><local:IconView Icon="Rules" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource Rules}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="14,0,0,0" FontSize="14" FontWeight="SemiBold" Visibility="{Binding NavTextVisibility}"/></StackPanel></Button>
     <Button Command="{Binding Navigate}" CommandParameter="Subscriptions" ToolTip="{DynamicResource Subscriptions}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding PageName}" Value="Subscriptions"><Setter Property="Tag" Value="Active"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><local:IconView Icon="Subscription" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource Subscriptions}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="14,0,0,0" FontSize="14" FontWeight="SemiBold" Visibility="{Binding NavTextVisibility}"/></StackPanel></Button>
     <Button Command="{Binding Navigate}" CommandParameter="Settings" ToolTip="{DynamicResource Settings}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding PageName}" Value="Settings"><Setter Property="Tag" Value="Active"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><local:IconView Icon="Settings" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource Settings}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="14,0,0,0" FontSize="14" FontWeight="SemiBold" Visibility="{Binding NavTextVisibility}"/></StackPanel></Button>
    </StackPanel>
    <Border Grid.Row="2" Background="{DynamicResource Card}" CornerRadius="14" Padding="10,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Border x:Name="FooterBadge" Style="{StaticResource IconBadge}" Width="30" Height="30" VerticalAlignment="Center"><local:IconView Icon="Shield" Width="17" Height="17" Foreground="{DynamicResource Accent}"/></Border><StackPanel Grid.Column="1" Margin="10,0,0,0" Visibility="{Binding NavTextVisibility}"><TextBlock Text="{Binding FooterLabel}" FontSize="12" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><Ellipse Width="6" Height="6" Margin="0,0,6,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource Muted}"/><Style.Triggers><DataTrigger Binding="{Binding Connected}" Value="True"><Setter Property="Fill" Value="{DynamicResource Success}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding FooterMode}" Style="{StaticResource Subtitle}" FontSize="11" LineHeight="12"/></StackPanel></StackPanel></Grid></Border>
   </Grid>
  </Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Button x:Name="MinimizeButton" Click="Minimize" Style="{StaticResource TitleButton}" ToolTip="{DynamicResource MinimizeWindow}" AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"><local:IconView Icon="Minimize" Width="22" Height="22"/></Button>
    <Button x:Name="MaximizeButton" Click="Maximize" AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}">
     <Button.Style><Style TargetType="Button" BasedOn="{StaticResource TitleButton}"><Setter Property="ToolTip" Value="{DynamicResource MaximizeWindow}"/><Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="ToolTip" Value="{DynamicResource RestoreWindow}"/></DataTrigger></Style.Triggers></Style></Button.Style>
     <local:IconView Width="22" Height="22"><local:IconView.Style><Style TargetType="local:IconView"><Setter Property="Icon" Value="Maximize"/><Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Icon" Value="Restore"/></DataTrigger></Style.Triggers></Style></local:IconView.Style></local:IconView>
    </Button>
    <Button x:Name="CloseButton" Click="CloseWindow" Style="{StaticResource CloseTitleButton}" ToolTip="{DynamicResource CloseWindow}" AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"><local:IconView Icon="Close" Width="22" Height="22"/></Button>
   </StackPanel>
   <StackPanel Grid.Row="1"><Border Visibility="{Binding BannerVisibility}" Margin="24,6,24,14" Background="{DynamicResource Card}" BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1" CornerRadius="12" Padding="14,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><local:IconView Icon="Info" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Banner}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"/><Button Grid.Column="2" Command="{Binding DismissBanner}" Style="{StaticResource QuietIconButton}" Margin="8,0,0,0"><local:IconView Icon="Close" Width="15" Height="15"/></Button></Grid></Border>
   </StackPanel>
   <ContentControl x:Name="PageContent" Grid.Row="2" Content="{Binding Page}" Margin="24,0,24,24"/>
  </Grid>
  <Button Grid.Column="1" Command="{Binding CollapseSidebar}" Width="26" Height="26" MinHeight="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-13,57,0,0" Padding="6" Background="{DynamicResource AccentSoft}" BorderThickness="0" Foreground="{DynamicResource Accent}" ToolTip="Свернуть / развернуть меню" shell:WindowChrome.IsHitTestVisibleInChrome="True"><local:IconView Icon="Chevron" Width="13" Height="13"><local:IconView.RenderTransform><ScaleTransform ScaleX="-1" CenterX="6.5"/></local:IconView.RenderTransform></local:IconView></Button>
 </Grid>
 <local:UpdateOverlay x:Name="UpdatePopup" Visibility="{Binding UpdateOverlayOpen, Converter={StaticResource BoolVisibility}}"/>
 </Grid>
</Window>
