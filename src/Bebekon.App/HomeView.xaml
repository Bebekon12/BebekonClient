<UserControl x:Class="Bebekon.App.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Bebekon.App">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ServerTemplates.xaml"/></ResourceDictionary.MergedDictionaries><local:ViewContext x:Key="ViewContext" Data="{Binding}"/></ResourceDictionary></UserControl.Resources>
 <ListBox x:Name="HomeScroll"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Margin" Value="0,0,0,6"/></Style></ListBox.ItemContainerStyle><ListBox.ItemsSource><CompositeCollection>
 <StackPanel x:Name="HomeOverview" DataContext="{Binding Data, Source={StaticResource ViewContext}}" Margin="0,0,0,0">
  <Border x:Name="Hero" Height="294" CornerRadius="14" BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1">
   <Border.Background><SolidColorBrush Color="#081B31"/></Border.Background>
   <Grid ClipToBounds="True">
    <local:ConnectionMap x:Name="HeroMap" ServerName="{Binding SelectedServer.Name}" Origin="{Binding MapOrigin}" Active="{Binding Connected}" Latency="{Binding SelectedServer.Latency}" LatencyMs="{Binding SelectedServer.LatencyMs}"/>
    <Image x:Name="HeroMascot" Source="/Bebekon.App;component/resources/snowman.png" Width="162" Height="184" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,8" IsHitTestVisible="False"/>
    <Border CornerRadius="14"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#C70C1729" Offset="0"/><GradientStop Color="#600C1729" Offset="0.48"/><GradientStop Color="#000C1729" Offset="0.8"/></LinearGradientBrush></Border.Background></Border>
    <Ellipse x:Name="PowerHalo" Width="300" Height="140" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,10" Fill="{DynamicResource Halo}" Opacity="0.18" IsHitTestVisible="False"/>
    <Viewbox Width="250" Height="72" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,14" Opacity="0.32" IsHitTestVisible="False"><Path x:Name="SpeedStreaks" Stroke="{DynamicResource Accent}" StrokeThickness="1.5" Data="M5,45 L75,31 M95,28 L125,22 M36,62 L98,49 M123,43 L175,31"><Path.RenderTransform><TranslateTransform x:Name="SpeedShift"/></Path.RenderTransform></Path></Viewbox>
    <Grid Margin="24,22"><Grid.ColumnDefinitions><ColumnDefinition Width="1.12*"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
       <TextBlock Text="{DynamicResource ConnectionOverview}" Foreground="#A7C9FF" FontSize="12"/>
       <Ellipse Width="8" Height="8" Margin="9,0,0,0" VerticalAlignment="Center" ToolTip="{Binding StatusLabel}"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource Muted}"/><Style.Triggers><DataTrigger Binding="{Binding Connected}" Value="True"><Setter Property="Fill" Value="{DynamicResource Success}"/></DataTrigger><DataTrigger Binding="{Binding ConnectionBusy}" Value="True"><Setter Property="Fill" Value="{DynamicResource Accent}"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Error"><Setter Property="Fill" Value="{DynamicResource Danger}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
      </StackPanel>
      <Viewbox Height="50" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Text="{Binding StatusLabel}" FontSize="42" FontWeight="Bold" Foreground="#F3F7FF"/></Viewbox>
      <TextBlock Text="{Binding StatusDetail}" Foreground="#B6CAEA" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" MaxHeight="36"/>
      <Button x:Name="ConnectPower" Command="{Binding ToggleConnect}" Style="{StaticResource AccentButton}" Width="218" Height="54" MinHeight="54" HorizontalAlignment="Left" Margin="0,20,0,0" Padding="18,10" AutomationProperties.Name="{Binding ConnectLabel}">
       <StackPanel Orientation="Horizontal"><Grid Width="27" Height="27" Margin="0,0,13,0"><local:IconView Icon="Power" Width="27" Height="27" Foreground="{DynamicResource OnAccent}" Visibility="{Binding ConnectionBusy, Converter={StaticResource InverseBoolVisibility}}"/><local:IconView Icon="Refresh" Width="23" Height="23" Foreground="{DynamicResource OnAccent}" RenderTransformOrigin="0.5,0.5" Visibility="{Binding ConnectionBusy, Converter={StaticResource BoolVisibility}}"><local:IconView.RenderTransform><RotateTransform x:Name="Orbit"/></local:IconView.RenderTransform></local:IconView></Grid><TextBlock Text="{Binding ConnectLabel}" Foreground="{DynamicResource OnAccent}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
      </Button>
     </StackPanel>
    </Grid>
   </Grid>
  </Border>
  <Border x:Name="ConnectionDock" Background="{DynamicResource PanelGradient}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" Margin="0,14,0,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.95*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
    <Grid Height="96">
     <Button x:Name="OpenServersCard" Command="{Binding Navigate}" CommandParameter="Servers" Style="{StaticResource DockButton}" ToolTip="{DynamicResource ServerTitle}" Padding="16,14"><StackPanel><TextBlock Text="{DynamicResource SelectedServerTitle}" Style="{StaticResource Eyebrow}"/><Grid Margin="0,13,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition/><ColumnDefinition Width="13"/></Grid.ColumnDefinitions><local:FlagView Country="{Binding SelectedServer.Name}" Width="29" Height="21" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding ServerLabel}" FontSize="14" FontWeight="SemiBold" Margin="8,0,4,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><local:IconView Grid.Column="2" Icon="Chevron" Width="12" Height="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></Grid></StackPanel></Button>
     <Button x:Name="HomePing" Command="{Binding PingServer}" Style="{StaticResource PingButton}" ToolTip="{DynamicResource PingAgain}" Height="30" MinHeight="30" Padding="4,0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="52,0,12,1" Background="Transparent" Foreground="{Binding SelectedServer.LatencyMs, Converter={StaticResource LatencyBrush}}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding SelectedServer.Latency, TargetNullValue=—}" FontWeight="SemiBold" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><local:IconView Icon="Refresh" Width="12" Height="12" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
    </Grid>
    <Grid Grid.Column="1" Height="96">
     <Border BorderBrush="{DynamicResource Border}" BorderThickness="1,0,1,0" Margin="0,14" IsHitTestVisible="False"/>
     <Button x:Name="ModeCard" Command="{Binding ChangeRoutingMode}" Style="{StaticResource DockButton}" ToolTip="{DynamicResource ChangeMode}" Padding="16,14"><StackPanel><TextBlock Text="{DynamicResource RoutingModeTitle}" Style="{StaticResource Eyebrow}" TextTrimming="CharacterEllipsis"/><Grid Margin="0,13,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition/><ColumnDefinition Width="13"/></Grid.ColumnDefinitions><local:IconView Icon="Rules" Width="20" Height="21" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding ModeLabel}" FontSize="14" FontWeight="SemiBold" Margin="8,0,4,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><local:IconView Grid.Column="2" Icon="Chevron" Width="12" Height="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></Grid></StackPanel></Button>
    </Grid>
    <StackPanel Grid.Column="2" Margin="16,14"><TextBlock Text="{DynamicResource NetworkComponents}" Style="{StaticResource Eyebrow}" TextTrimming="CharacterEllipsis"/><UniformGrid Columns="3" Margin="0,10,0,0">
     <StackPanel HorizontalAlignment="Left"><TextBlock Text="TUN" FontSize="11" Margin="0,0,0,5"/><CheckBox x:Name="HomeTun" IsChecked="{Binding IsTunMode}" Style="{StaticResource Switch}" ToolTip="{DynamicResource TunDetail}" AutomationProperties.Name="TUN"/></StackPanel>
     <StackPanel HorizontalAlignment="Center"><TextBlock Text="{DynamicResource Proxy}" FontSize="11" Margin="0,0,0,5"/><CheckBox x:Name="HomeProxy" IsChecked="{Binding IsProxyMode}" Style="{StaticResource Switch}" ToolTip="{DynamicResource ProxyDetail}" AutomationProperties.Name="{DynamicResource Proxy}"/></StackPanel>
     <StackPanel HorizontalAlignment="Right"><TextBlock Text="DNS" FontSize="11" Margin="0,0,0,2"/><Button Command="{Binding ChangeTunnelMode}" CommandParameter="DNS" Style="{StaticResource QuietIconButton}" Width="32" Height="30" ToolTip="{DynamicResource ConfigureDns}" AutomationProperties.Name="{DynamicResource ConfigureDns}"><local:IconView Icon="Settings" Width="17" Height="17"/></Button></StackPanel>
    </UniformGrid></StackPanel>
   </Grid>
  </Border>
  <Border x:Name="TrafficStrip" Background="{DynamicResource PanelGradient}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" Padding="16,15" Margin="0,14,0,0" ToolTip="Скорость сейчас, объём за сессию и график последних 120 измерений. Включает прямые маршруты через ядро.">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
    <Grid Margin="0,0,13,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="0.55*"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><local:IconView Icon="Download" Width="14" Height="14" Foreground="{DynamicResource Accent}" Margin="0,0,6,0"/><TextBlock Text="{DynamicResource DownloadSpeed}" Style="{StaticResource Subtitle}" FontSize="11"/></StackPanel><TextBlock x:Name="DownloadSpeed" Text="{Binding DownloadRate}" FontSize="26" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="{DynamicResource Mbps}" Style="{StaticResource Subtitle}" FontSize="10"/><TextBlock Text="{Binding DownloadTotal}" Style="{StaticResource Subtitle}" FontSize="10" Margin="0,3,0,0"/></StackPanel><local:TrafficChart x:Name="DownloadChart" Grid.Column="1" Samples="{Binding DownloadHistory}" Stroke="{DynamicResource Accent}" Height="38" VerticalAlignment="Bottom" Margin="5,0,0,9" IsHitTestVisible="False"/></Grid>
    <Grid Grid.Column="1" Margin="0,0,13,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="0.55*"/></Grid.ColumnDefinitions><Border BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0" Padding="14,0,0,0"><StackPanel><StackPanel Orientation="Horizontal"><local:IconView Icon="Upload" Width="14" Height="14" Foreground="{DynamicResource Accent}" Margin="0,0,6,0"/><TextBlock Text="{DynamicResource UploadSpeed}" Style="{StaticResource Subtitle}" FontSize="11"/></StackPanel><TextBlock x:Name="UploadSpeed" Text="{Binding UploadRate}" FontSize="26" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="{DynamicResource Mbps}" Style="{StaticResource Subtitle}" FontSize="10"/><TextBlock Text="{Binding UploadTotal}" Style="{StaticResource Subtitle}" FontSize="10" Margin="0,3,0,0"/></StackPanel></Border><local:TrafficChart x:Name="UploadChart" Grid.Column="1" Samples="{Binding UploadHistory}" Stroke="{DynamicResource Accent}" Height="38" VerticalAlignment="Bottom" Margin="5,0,0,9" IsHitTestVisible="False"/></Grid>
    <Border Grid.Column="2" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0" Padding="14,0"><StackPanel><StackPanel Orientation="Horizontal"><local:IconView Icon="Clock" Width="14" Height="14" Foreground="{DynamicResource Accent}" Margin="0,0,6,0"/><TextBlock Text="{DynamicResource Session}" Style="{StaticResource Subtitle}" FontSize="11"/></StackPanel><TextBlock Text="{Binding Session}" FontSize="20" FontWeight="SemiBold" Margin="0,9,0,0"/></StackPanel></Border>
    <Border Grid.Column="3" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0" Padding="14,0,0,0"><StackPanel>
     <TextBlock Text="{Binding PublicIpLabel}" Style="{StaticResource Subtitle}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding PublicIpLabel}"/>
     <TextBlock Text="{Binding VpnIp}" FontFamily="Cascadia Mono" FontSize="13" FontWeight="SemiBold" Margin="0,5,0,9" TextTrimming="CharacterEllipsis" ToolTip="{Binding VpnIp}"/>
     <TextBlock Text="{Binding LocalIpLabel}" Style="{StaticResource Subtitle}" FontSize="10"/>
     <TextBlock Text="{Binding LocalIp}" FontFamily="Cascadia Mono" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding LocalIpDetail}"/>
    </StackPanel></Border>
   </Grid>
  </Border>
  <Border x:Name="HomeServerPanel" Background="{DynamicResource PanelGradient}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" Padding="16,16,16,4" Margin="0,18,0,0">
   <StackPanel><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource AllServersTitle}" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource AllServersDetail}" Style="{StaticResource Subtitle}" FontSize="11" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="9,5" VerticalAlignment="Center"><TextBlock Text="{Binding ServerCount}" Foreground="{DynamicResource Accent}" FontSize="12"/></Border></Grid><local:ServersView x:Name="HomeServers" Embedded="True" ToolbarOnly="True"/><StackPanel x:Name="HomeEmptyServers" Visibility="{Binding NoServers}" Margin="0,8,0,16"><TextBlock Text="{DynamicResource NoServersDetail}" Style="{StaticResource Subtitle}" TextWrapping="Wrap"/><Button Content="{DynamicResource AddSubscription}" Command="{Binding AddSubscription}" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></StackPanel>
  </Border>
 </StackPanel>
 <CollectionContainer Collection="{Binding Data.ServerRows, Source={StaticResource ViewContext}}"/>
 </CompositeCollection></ListBox.ItemsSource></ListBox>
</UserControl>
