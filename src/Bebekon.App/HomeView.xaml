<UserControl x:Class="Bebekon.App.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Bebekon.App">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
  <Grid Height="246">
   <Ellipse Width="188" Height="188" VerticalAlignment="Top" Margin="0,6,0,0" Fill="#113C47"><Ellipse.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#25BDBB" Opacity="0.24"/></Ellipse.Effect></Ellipse>
   <Button Command="{Binding ToggleConnect}" Width="170" Height="170" VerticalAlignment="Top" Margin="0,15,0,0" Background="{StaticResource AccentGradient}" BorderThickness="1" BorderBrush="#61E2F0"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Circle" Background="{TemplateBinding Background}" CornerRadius="85" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Opacity" Value="0.88"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Circle" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Circle" Property="Opacity" Value="0.6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template><StackPanel><TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons" FontSize="38" HorizontalAlignment="Center" Foreground="White"/><TextBlock Text="{Binding ConnectLabel}" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="White" Margin="0,12,0,0"/></StackPanel></Button>
   <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,0"><TextBlock Text="{Binding StatusLabel}" HorizontalAlignment="Center" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding StatusDetail}" HorizontalAlignment="Center" Style="{StaticResource Subtitle}" Margin="0,5,0,0"/></StackPanel>
  </Grid>
  <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource CardStyle}" Margin="0,0,7,0" Height="106"><StackPanel><TextBlock Text="{DynamicResource Server}" FontSize="10" Foreground="{StaticResource Muted}"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><local:FlagView Country="{Binding SelectedServer.Name}" Width="28" Height="20"/><TextBlock Text="{Binding ServerLabel}" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="210"/></StackPanel><TextBlock Text="{Binding SelectedServer.Latency, TargetNullValue=—}" FontSize="12" Foreground="{StaticResource Accent}" Margin="0,6,0,0"/></StackPanel></Border>
   <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="7,0,0,0" Height="106"><StackPanel><TextBlock Text="{DynamicResource Mode}" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding ModeLabel}" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0"/></StackPanel></Border>
  </Grid>
  <UniformGrid Columns="3" Margin="0,14,0,0"><Border Style="{StaticResource CardStyle}" Margin="0,0,7,0" Padding="12" Height="76"><StackPanel><TextBlock Text="—" FontSize="24" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/><TextBlock Text="{DynamicResource Mbps}" Style="{StaticResource Subtitle}" FontSize="11" HorizontalAlignment="Center"/></StackPanel></Border><Border Style="{StaticResource CardStyle}" Margin="7,0" Padding="12" Height="76"><StackPanel><TextBlock Text="—" FontSize="24" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/><TextBlock Text="{DynamicResource Mbps}" Style="{StaticResource Subtitle}" FontSize="11" HorizontalAlignment="Center"/></StackPanel></Border><Border Style="{StaticResource CardStyle}" Margin="7,0,0,0" Padding="12" Height="76"><StackPanel><TextBlock Text="{Binding Session}" FontSize="23" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/><TextBlock Text="{DynamicResource Session}" Style="{StaticResource Subtitle}" FontSize="11" HorizontalAlignment="Center"/></StackPanel></Border></UniformGrid>
  <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="20,15"><StackPanel><TextBlock Text="{DynamicResource VpnIp}" Style="{StaticResource Subtitle}" FontSize="10"/><TextBlock Text="{Binding VpnIp}" FontFamily="Cascadia Mono" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,4"/><TextBlock Text="{DynamicResource VpnIpDetail}" Style="{StaticResource Subtitle}" FontSize="11"/></StackPanel></Border>
  <UniformGrid Columns="3" Margin="0,16,0,0"><Button Content="TUN" Command="{Binding ChangeTunnelMode}" CommandParameter="TUN" Margin="0,0,7,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Settings.TunnelMode}" Value="Tun"><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="Background" Value="#0D3039"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="{DynamicResource Proxy}" Command="{Binding ChangeTunnelMode}" CommandParameter="Proxy" Margin="7,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Settings.TunnelMode}" Value="Proxy"><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="DNS" Command="{Binding ChangeTunnelMode}" CommandParameter="DNS" Margin="7,0,0,0"/></UniformGrid>
 </StackPanel></ScrollViewer>
</UserControl>
