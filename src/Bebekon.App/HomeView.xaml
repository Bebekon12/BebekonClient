<UserControl x:Class="Bebekon.App.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Bebekon.App">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,4,0">
  <Grid Height="248">
   <Ellipse x:Name="PowerHalo" Width="186" Height="186" VerticalAlignment="Top" Margin="0,7,0,0" Fill="{StaticResource AccentSoft}" Opacity="0.6"><Ellipse.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="0" Color="#35DADE" Opacity="0.22"/></Ellipse.Effect></Ellipse>
   <Button Command="{Binding ToggleConnect}" Width="170" Height="170" MinHeight="0" VerticalAlignment="Top" Margin="0,15,0,0" Background="{StaticResource AccentGradient}" BorderBrush="#67E4E6" BorderThickness="1" Padding="0" AutomationProperties.Name="{Binding ConnectLabel}"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Circle" Background="{TemplateBinding Background}" CornerRadius="85" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Opacity" Value="0.9"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Circle" Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Circle" Property="Opacity" Value="0.55"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Circle" Property="BorderThickness" Value="3"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template><StackPanel><local:IconView Icon="Power" Width="40" Height="40" Foreground="#F1FFFF" HorizontalAlignment="Center"/><TextBlock Text="{Binding ConnectLabel}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#F1FFFF" Margin="0,13,0,0"/></StackPanel></Button>
   <StackPanel VerticalAlignment="Bottom"><TextBlock Text="{Binding StatusLabel}" HorizontalAlignment="Center" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding StatusDetail}" HorizontalAlignment="Center" Style="{StaticResource Subtitle}" Margin="0,6,0,0"/></StackPanel>
  </Grid>
  <Grid Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource CardStyle}" Margin="0,0,7,0" Height="104"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><local:IconView Icon="Servers" Width="12" Height="12" Foreground="{StaticResource Muted}" Margin="0,0,6,0"/><TextBlock Text="{DynamicResource Server}" Style="{StaticResource Eyebrow}"/></StackPanel><Grid Grid.Row="1" Margin="0,8,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions><local:FlagView Country="{Binding SelectedServer.Name}" Width="28" Height="20" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding ServerLabel}" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid><TextBlock Grid.Row="2" Text="{Binding SelectedServer.Latency, TargetNullValue=—}" FontSize="11" Foreground="{StaticResource Muted}"/></Grid></Border>
   <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="7,0,0,0" Height="104"><StackPanel><StackPanel Orientation="Horizontal"><local:IconView Icon="Rules" Width="12" Height="12" Foreground="{StaticResource Muted}" Margin="0,0,6,0"/><TextBlock Text="{DynamicResource Mode}" Style="{StaticResource Eyebrow}"/></StackPanel><TextBlock Text="{Binding ModeLabel}" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,0"/></StackPanel></Border>
  </Grid>
  <UniformGrid Columns="3" Margin="0,14,0,0">
   <Border Style="{StaticResource CardStyle}" Margin="0,0,7,0" Padding="12" Height="78"><StackPanel><TextBlock Text="—" FontSize="24" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><local:IconView Icon="Download" Width="12" Height="12" Foreground="{StaticResource Muted}" Margin="0,0,5,0"/><TextBlock Text="{DynamicResource Mbps}" Style="{StaticResource Subtitle}" FontSize="11"/></StackPanel></StackPanel></Border>
   <Border Style="{StaticResource CardStyle}" Margin="7,0" Padding="12" Height="78"><StackPanel><TextBlock Text="—" FontSize="24" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><local:IconView Icon="Upload" Width="12" Height="12" Foreground="{StaticResource Muted}" Margin="0,0,5,0"/><TextBlock Text="{DynamicResource Mbps}" Style="{StaticResource Subtitle}" FontSize="11"/></StackPanel></StackPanel></Border>
   <Border Style="{StaticResource CardStyle}" Margin="7,0,0,0" Padding="12" Height="78"><StackPanel><TextBlock Text="{Binding Session}" FontSize="23" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/><TextBlock Text="{DynamicResource Session}" Style="{StaticResource Subtitle}" FontSize="11" HorizontalAlignment="Center"/></StackPanel></Border>
  </UniformGrid>
  <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="18,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource IconBadge}" Width="34" Height="34" VerticalAlignment="Center"><local:IconView Icon="Network" Foreground="{StaticResource Accent}"/></Border><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="{DynamicResource VpnIp}" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding VpnIp}" FontFamily="Cascadia Mono" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,2"/><TextBlock Text="{DynamicResource VpnIpDetail}" Style="{StaticResource Subtitle}" FontSize="11"/></StackPanel></Grid></Border>
  <UniformGrid Columns="3" Margin="0,16,0,0">
   <Button Command="{Binding ChangeTunnelMode}" CommandParameter="TUN" Margin="0,0,7,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsTunMode}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="Background" Value="{StaticResource AccentSoft}"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><local:IconView Icon="Shield" Width="17" Height="17" Margin="0,0,8,0"/><TextBlock Text="TUN" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="13" FontWeight="SemiBold"/></StackPanel></Button>
   <Button Command="{Binding ChangeTunnelMode}" CommandParameter="Proxy" Margin="7,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsProxyMode}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="Background" Value="{StaticResource AccentSoft}"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><local:IconView Icon="Proxy" Width="17" Height="17" Margin="0,0,8,0"/><TextBlock Text="{DynamicResource Proxy}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="13" FontWeight="SemiBold"/></StackPanel></Button>
   <Button Command="{Binding ChangeTunnelMode}" CommandParameter="DNS" Margin="7,0,0,0" Foreground="{StaticResource Muted}"><StackPanel Orientation="Horizontal"><local:IconView Icon="Network" Width="17" Height="17" Margin="0,0,8,0"/><TextBlock Text="DNS" Foreground="{StaticResource Muted}" FontSize="13" FontWeight="SemiBold"/></StackPanel></Button>
  </UniformGrid>
 </StackPanel></ScrollViewer>
</UserControl>
