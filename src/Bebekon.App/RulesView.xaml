<UserControl x:Class="Bebekon.App.RulesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Bebekon.App">
 <UserControl.Resources><local:InverseBoolConverter x:Key="InverseBool"/></UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,12"><TextBlock Text="{DynamicResource RoutingTitle}" Style="{StaticResource Heading}"/><TextBlock Text="{DynamicResource RoutingSubtitle}" Style="{StaticResource Subtitle}"/></StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <RadioButton GroupName="RoutingMode" IsChecked="{Binding IsWholePc}" Style="{StaticResource ModeCard}" Margin="0,0,7,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource IconBadge}" Background="{DynamicResource CardHover}"><local:IconView Icon="Monitor" Foreground="{DynamicResource Muted}"/></Border><StackPanel Grid.Column="1" Margin="13,1,0,0" VerticalAlignment="Center"><TextBlock Text="{DynamicResource EntirePc}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource EntireDetail}" Style="{StaticResource Subtitle}" Margin="0,3,0,0"/></StackPanel></Grid></RadioButton>
   <RadioButton Grid.Column="1" GroupName="RoutingMode" IsChecked="{Binding IsWholePc, Converter={StaticResource InverseBool}}" Style="{StaticResource ModeCard}" Margin="7,0,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource IconBadge}"><local:IconView Icon="Rules" Foreground="{DynamicResource Accent}"/></Border><StackPanel Grid.Column="1" Margin="13,1,0,0" VerticalAlignment="Center"><TextBlock Text="{DynamicResource ByRules}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource RulesDetail}" Style="{StaticResource Subtitle}" Margin="0,3,0,0"/></StackPanel></Grid></RadioButton>
  </Grid>
  <Grid Grid.Row="2" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource CardStyle}" Background="{DynamicResource FeatureGradient}" BorderBrush="{DynamicResource AccentBorder}" Padding="12" Margin="0,0,7,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Style="{StaticResource IconBadge}" Width="38" Height="38" Background="{DynamicResource AccentGradient}"><local:IconView Icon="Application" Foreground="{DynamicResource OnAccent}" Width="20" Height="20"/></Border><StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center"><TextBlock Text="{DynamicResource Applications}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{DynamicResource ApplicationShortcutDetail}" Style="{StaticResource Subtitle}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="2" Content="{DynamicResource Open}" Command="{Binding AddApplication}" Style="{StaticResource AccentButton}" VerticalAlignment="Center" Padding="12,10"/></Grid></Border>
   <Border Grid.Column="1" Style="{StaticResource CardStyle}" Background="{DynamicResource FeatureGradient}" BorderBrush="{DynamicResource AccentBorder}" Padding="12" Margin="7,0,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Style="{StaticResource IconBadge}" Width="38" Height="38" Background="{DynamicResource AccentGradient}"><local:IconView Icon="Sparkles" Foreground="{DynamicResource OnAccent}" Width="20" Height="20"/></Border><StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center"><TextBlock Text="{DynamicResource Presets}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{DynamicResource AdminShortcutDetail}" Style="{StaticResource Subtitle}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="2" Content="{DynamicResource Add}" Command="{Binding AddPreset}" Style="{StaticResource AccentButton}" VerticalAlignment="Center" Padding="12,10"/></Grid></Border>
  </Grid>
  <StackPanel Grid.Row="3"><Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{DynamicResource MyRules}" FontSize="17" FontWeight="SemiBold"/><Border Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="8,2" Margin="10,0,0,0"><TextBlock Text="{Binding RuleCount}" Foreground="{DynamicResource Accent}" FontSize="12" FontWeight="SemiBold"/></Border></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Command="{Binding ImportProfile}" Style="{StaticResource IconButton}" ToolTip="{DynamicResource Import}" Margin="0,0,8,0"><local:IconView Icon="Download" Width="17" Height="17"/></Button><Button Command="{Binding ExportProfile}" Style="{StaticResource IconButton}" ToolTip="{DynamicResource Export}" Margin="0,0,8,0"><local:IconView Icon="Upload" Width="17" Height="17"/></Button><Button Command="{Binding AddRule}" Style="{StaticResource AccentButton}"><StackPanel Orientation="Horizontal"><local:IconView Icon="Plus" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="{DynamicResource Add}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="14" FontWeight="SemiBold"/></StackPanel></Button></StackPanel></Grid>
   <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Data.Profiles}" DisplayMemberPath="Name" SelectedItem="{Binding ActiveProfile}" Width="190" HorizontalAlignment="Left"/><Button Grid.Column="1" Content="{DynamicResource CreateProfile}" Command="{Binding AddProfile}" Margin="10,0,8,0"/><Button Grid.Column="2" Command="{Binding DeleteProfile}" ToolTip="{DynamicResource DeleteProfile}" Style="{StaticResource IconButton}"><local:IconView Icon="Trash" Width="17" Height="17"/></Button></Grid>
  </StackPanel>
  <StackPanel Grid.Row="4" Margin="0,8,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="168"/></Grid.ColumnDefinitions><TextBox Tag="{DynamicResource SearchRules}" Text="{Binding RuleSearch, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" Margin="0,0,8,0"/><ComboBox Grid.Column="1" SelectedIndex="{Binding RuleSortIndex}"><ComboBoxItem Content="{DynamicResource NewestFirst}"/><ComboBoxItem Content="{DynamicResource ByPriority}"/></ComboBox></Grid><TextBlock Text="{Binding RulesOrderHint}" Style="{StaticResource Subtitle}" FontSize="11" Margin="2,6,0,0" TextWrapping="Wrap"/></StackPanel>
  <ListBox x:Name="RulesList" Grid.Row="5" ItemsSource="{Binding VisibleRules}" AllowDrop="True" PreviewMouseLeftButtonDown="BeginDrag" PreviewMouseMove="MoveDrag" Drop="DropRule"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Margin" Value="0"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="6,11" MinHeight="64"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Card}"/></Trigger></Style.Triggers></Style></Border.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="86"/><ColumnDefinition Width="56"/><ColumnDefinition Width="32"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><local:IconView Icon="Grip" Width="12" Height="18" Foreground="{DynamicResource Muted}" Opacity="0.45" VerticalAlignment="Center"/><Border Grid.Column="1" Style="{StaticResource IconBadge}" Width="32" Height="32" VerticalAlignment="Center"><local:IconView Icon="{Binding Kind}" Width="17" Height="17" Foreground="{DynamicResource Accent}"/></Border><StackPanel Grid.Column="2" Margin="11,0,10,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Description}" Style="{StaticResource Subtitle}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel><Border x:Name="RouteBadge" Grid.Column="3" Background="#2D2B22" CornerRadius="13" Padding="9,5" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock x:Name="RouteLabel" Text="{Binding RouteLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Warning}"/></Border><CheckBox Grid.Column="4" IsChecked="{Binding UseVpn}" Style="{StaticResource Switch}" ToolTip="{Binding RouteLabel}" VerticalAlignment="Center"/><Button Grid.Column="5" Command="{Binding DataContext.EditRule, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource QuietIconButton}" ToolTip="{DynamicResource Edit}"><local:IconView Icon="Edit" Width="15" Height="15"/></Button><Button Grid.Column="6" Command="{Binding DataContext.DeleteRule, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource QuietIconButton}" ToolTip="{DynamicResource Delete}"><local:IconView Icon="Trash" Width="15" Height="15"/></Button></Grid></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding UseVpn}" Value="True"><Setter TargetName="RouteLabel" Property="Foreground" Value="{DynamicResource Success}"/><Setter TargetName="RouteBadge" Property="Background" Value="#10322D"/></DataTrigger></DataTemplate.Triggers></DataTemplate></ListBox.ItemTemplate></ListBox>
  <StackPanel Grid.Row="5" Visibility="{Binding NoRules}" VerticalAlignment="Center" HorizontalAlignment="Center"><local:IconView Icon="Rules" Width="32" Height="32" Foreground="{DynamicResource Muted}" Margin="0,0,0,12"/><TextBlock Text="{DynamicResource NoRules}" HorizontalAlignment="Center" FontSize="16"/><TextBlock Text="{Binding EmptyRulesDetail}" Style="{StaticResource Subtitle}" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel>
 </Grid>
</UserControl>
