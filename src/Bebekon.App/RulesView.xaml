<UserControl x:Class="Bebekon.App.RulesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock Text="{DynamicResource RoutingTitle}" Style="{StaticResource Heading}"/><TextBlock Text="{DynamicResource RoutingSubtitle}" Style="{StaticResource Subtitle}"/></StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <RadioButton GroupName="RoutingMode" IsChecked="{Binding IsWholePc}" Margin="0,0,7,0"><RadioButton.Template><ControlTemplate TargetType="RadioButton"><Border x:Name="B" Background="{StaticResource Card}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="18" Padding="18"><StackPanel><TextBlock Text="{DynamicResource EntirePc}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource EntireDetail}" Style="{StaticResource Subtitle}" Margin="0,5,0,0"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="B" Property="Background" Value="#10353D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></RadioButton.Template></RadioButton>
   <RadioButton Grid.Column="1" GroupName="RoutingMode" Margin="7,0,0,0" Checked="RulesMode"><RadioButton.Style><Style TargetType="RadioButton"><Style.Triggers><DataTrigger Binding="{Binding IsWholePc}" Value="False"><Setter Property="IsChecked" Value="True"/></DataTrigger></Style.Triggers></Style></RadioButton.Style><RadioButton.Template><ControlTemplate TargetType="RadioButton"><Border x:Name="B" Background="{StaticResource Card}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="18" Padding="18"><StackPanel><TextBlock Text="{DynamicResource ByRules}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource RulesDetail}" Style="{StaticResource Subtitle}" Margin="0,5,0,0"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="B" Property="Background" Value="#10353D"/><Setter TargetName="B" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></RadioButton.Template></RadioButton>
  </Grid>
  <Border Grid.Row="2" Style="{StaticResource CardStyle}" Background="#102E37" BorderBrush="#21606A" Padding="18" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="{StaticResource AccentGradient}" CornerRadius="13" Width="44" Height="44"><TextBlock Text="▦" FontSize="24" Foreground="#07313C" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="14,2,10,0"><TextBlock Text="{DynamicResource Applications}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource ApplicationsDetail}" Style="{StaticResource Subtitle}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="2" Content="{DynamicResource Open}" Command="{Binding AddApplication}" Style="{StaticResource AccentButton}" VerticalAlignment="Center"/></Grid></Border>
  <Border Grid.Row="3" Style="{StaticResource CardStyle}" Background="#102E37" BorderBrush="#21606A" Padding="18" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="{StaticResource AccentGradient}" CornerRadius="13" Width="44" Height="44"><TextBlock Text="✦" FontSize="24" Foreground="#07313C" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="14,2,10,0"><TextBlock Text="{DynamicResource Presets}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource PresetsDetail}" Style="{StaticResource Subtitle}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="2" Content="{DynamicResource AddPreset}" Command="{Binding AddPreset}" Style="{StaticResource AccentButton}" VerticalAlignment="Center"/></Grid></Border>
  <StackPanel Grid.Row="4"><Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{DynamicResource MyRules}" FontSize="17" FontWeight="SemiBold"/><Border Background="#124048" CornerRadius="8" Padding="9,2" Margin="10,0,0,0"><TextBlock Text="{Binding RuleCount}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/></Border></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="↓" Command="{Binding ImportProfile}" Style="{StaticResource IconButton}" ToolTip="{DynamicResource Import}" Margin="0,0,8,0"/><Button Content="↑" Command="{Binding ExportProfile}" Style="{StaticResource IconButton}" ToolTip="{DynamicResource Export}" Margin="0,0,8,0"/><Button Content="{DynamicResource Add}" Command="{Binding AddRule}" Style="{StaticResource AccentButton}"/></StackPanel></Grid>
   <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Data.Profiles}" DisplayMemberPath="Name" SelectedItem="{Binding ActiveProfile}" MaxWidth="230" HorizontalAlignment="Left" MinWidth="170"/><Button Grid.Column="1" Content="{DynamicResource CreateProfile}" Command="{Binding AddProfile}" Margin="10,0,8,0"/><Button Grid.Column="2" Content="×" Command="{Binding DeleteProfile}" ToolTip="{DynamicResource DeleteProfile}" Style="{StaticResource IconButton}"/></Grid>
  </StackPanel>
  <StackPanel Grid.Row="5" Margin="0,12,0,10"><TextBox Tag="{DynamicResource SearchRules}" Text="{Binding RuleSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource SearchRules}"/><TextBlock Text="{DynamicResource RuleTip}" Foreground="{StaticResource Muted}" FontSize="11" Margin="2,7,0,0" TextWrapping="Wrap"/></StackPanel>
  <ListBox Grid.Row="6" ItemsSource="{Binding VisibleRules}" AllowDrop="True" PreviewMouseLeftButtonDown="BeginDrag" PreviewMouseMove="MoveDrag" Drop="DropRule"><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource CardStyle}" Padding="14,12" CornerRadius="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition/><ColumnDefinition Width="84"/><ColumnDefinition Width="50"/><ColumnDefinition Width="36"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="12" Background="#28364B"><TextBlock Text="{Binding Glyph}" FontSize="20" Foreground="#9990F8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="10,0,8,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding RouteLabel}" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource Accent}"/><CheckBox Grid.Column="3" IsChecked="{Binding UseVpn}" Style="{StaticResource Switch}" Margin="0" ToolTip="{Binding RouteLabel}"/><Button Grid.Column="4" Content="✎" Command="{Binding DataContext.EditRule, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="5" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Muted}"/><Button Grid.Column="5" Content="×" Command="{Binding DataContext.DeleteRule, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="5" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Muted}"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
  <StackPanel Grid.Row="6" Visibility="{Binding NoRules}" VerticalAlignment="Center"><TextBlock Text="{DynamicResource NoRules}" HorizontalAlignment="Center" Foreground="{StaticResource Muted}"/><TextBlock Text="{DynamicResource NoRulesDetail}" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/></StackPanel>
 </Grid>
</UserControl>
