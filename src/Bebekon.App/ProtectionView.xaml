<UserControl x:Class="Bebekon.App.ProtectionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Bebekon.App">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,6,12">
  <TextBlock Text="{DynamicResource Protection}" Style="{StaticResource Heading}"/>
  <TextBlock Text="{Binding ProtectionSummary}" Style="{StaticResource Subtitle}" Margin="0,4,0,16" TextWrapping="Wrap"/>
  <local:SettingRow Icon="Shield" Title="{DynamicResource GlobalGuard}" Description="{DynamicResource GlobalGuardHelp}"><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding KillSwitchEnabled}" AutomationProperties.Name="{DynamicResource GlobalGuard}"/></local:SettingRow>
  <local:SettingRow Icon="Clock" Title="{DynamicResource PersistentWfp}" Description="{DynamicResource PersistentGuardHelp}"><CheckBox Style="{StaticResource Switch}" IsEnabled="{Binding KillSwitchEnabled}" IsChecked="{Binding PersistentProtection}" AutomationProperties.Name="{DynamicResource PersistentWfp}"/></local:SettingRow>
  <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12"><StackPanel>
   <TextBlock Text="{DynamicResource DestinationGuardTitle}" FontWeight="SemiBold"/>
   <TextBlock Text="{Binding DestinationDetails}" Style="{StaticResource Subtitle}" TextWrapping="Wrap" Margin="0,5,0,8"/>
   <WrapPanel><Button Content="{DynamicResource DestinationList}" Command="{Binding EditDestinations}" Style="{StaticResource AccentButton}" Margin="0,0,8,0"/><Button Content="{Binding DestinationToggle}" Command="{Binding ToggleDestinations}"/></WrapPanel>
  </StackPanel></Border>
  <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12"><StackPanel>
   <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding ProtectedRuleCount}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource ProtectedRules}" FontWeight="SemiBold"/></DockPanel>
   <TextBlock Text="{DynamicResource SpecificGuardHelp}" Style="{StaticResource Subtitle}" TextWrapping="Wrap" Margin="0,5,0,0"/>
  </StackPanel></Border>
  <Expander Header="{DynamicResource GuardDiagnostics}" Style="{StaticResource DetailsPanel}">
   <StackPanel><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Protection.Filters, FallbackValue=—, TargetNullValue=—}"/><TextBlock Text="{DynamicResource WfpCount}"/></DockPanel>
    <TextBlock Text="{Binding Protection.Error}" Foreground="{DynamicResource Warning}" TextWrapping="Wrap"/>
    <TextBlock Text="{DynamicResource WfpTestScope}" Style="{StaticResource Subtitle}" TextWrapping="Wrap" Margin="0,8"/>
    <WrapPanel><Button Content="{DynamicResource Update}" Command="{Binding RefreshProtection}" Margin="0,0,8,6"/><Button Content="{DynamicResource LocalWfpTest}" Command="{Binding TestWfp}" Margin="0,0,8,6"/><Button Content="{DynamicResource ApplyStoredWfp}" Command="{Binding ApplyStoredProtection}" Margin="0,0,8,6"/><Button Content="{DynamicResource ClearWfp}" Command="{Binding ClearProtection}" Margin="0,0,0,6"/></WrapPanel>
    <TextBlock Text="{Binding WfpResult}" TextWrapping="Wrap"/>
    <TextBlock Text="{DynamicResource WfpEventLog}" FontWeight="SemiBold" Margin="0,10,0,3"/><TextBlock Text="{Binding WfpEvents}" TextWrapping="Wrap" Style="{StaticResource Subtitle}"/>
   </StackPanel>
  </Expander>
 </StackPanel></ScrollViewer>
</UserControl>