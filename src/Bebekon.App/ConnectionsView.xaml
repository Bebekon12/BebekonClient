<UserControl x:Class="Bebekon.App.ConnectionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel>
   <TextBlock Text="{DynamicResource Connections}" Style="{StaticResource Heading}" Margin="0,0,0,16"/>
   <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,10">
    <DockPanel>
     <Button DockPanel.Dock="Right" Content="{Binding ConnectLabel}" Command="{Binding ToggleConnect}" VerticalAlignment="Center"/>
     <StackPanel>
      <TextBlock Text="Bebekon VPN" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
      <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource Subtitle}" Margin="0,4,0,0"/>
      <TextBlock Text="{Binding VpnIp}" Style="{StaticResource Subtitle}" Margin="0,4,0,0"/>
     </StackPanel>
    </DockPanel>
   </Border>
   <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,10">
    <StackPanel>
     <TextBlock Text="NetBird" FontSize="16" FontWeight="SemiBold" Foreground="#BEA7FF"/>
     <TextBlock Text="{Binding NetBirdSummary}" Style="{StaticResource Subtitle}" Margin="0,4,0,0"/>
     <TextBlock Text="{Binding NetBirdInterfaceInfo}" Style="{StaticResource Subtitle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
     <WrapPanel Margin="0,10,0,0">
      <Button Content="{DynamicResource NetBirdUp}" Command="{Binding ChangeNetBird}" CommandParameter="Up" Margin="0,0,8,0"/>
      <Button Content="{DynamicResource NetBirdDown}" Command="{Binding ChangeNetBird}" CommandParameter="Down"/>
     </WrapPanel>
    </StackPanel>
   </Border>
   <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,10">
    <StackPanel>
     <TextBlock Text="Direct" FontSize="16" FontWeight="SemiBold"/>
     <TextBlock Text="{DynamicResource DirectInterface}" Style="{StaticResource Subtitle}" Margin="0,4,0,0"/>
     <TextBlock Text="{Binding Uplink}" Margin="0,4,0,0"/>
    </StackPanel>
   </Border>
   <Border Style="{StaticResource CardStyle}" Padding="16">
    <StackPanel>
     <TextBlock Text="{DynamicResource NetworkSnapshot}" FontWeight="SemiBold" FontSize="16"/>
     <TextBlock Text="{Binding WindowsNetwork}" Style="{StaticResource Subtitle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
     <WrapPanel Margin="0,10,0,0">
      <Button Content="{DynamicResource Update}" Command="{Binding RefreshConnections}" Margin="0,0,8,0"/>
      <Button Content="{DynamicResource CheckRouteNow}" Command="{Binding CheckRoute}"/>
     </WrapPanel>
    </StackPanel>
   </Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
