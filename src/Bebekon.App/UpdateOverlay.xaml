<UserControl x:Class="Bebekon.App.UpdateOverlay" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Bebekon.App" KeyboardNavigation.TabNavigation="Cycle" Focusable="True">
 <Grid Background="#B8061119">
  <Border x:Name="UpdateCard" Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="24" Background="{DynamicResource Background}" BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1" Padding="28">
   <StackPanel>
    <Grid Height="96" Margin="0,0,0,16">
     <Ellipse Width="150" Height="96" Fill="{DynamicResource Halo}" Opacity="0.3" IsHitTestVisible="False"/>
     <Border Width="68" Height="68" Background="{DynamicResource FeatureGradient}" CornerRadius="22" BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1"><local:IconView Icon="Download" Width="30" Height="30" Foreground="{DynamicResource Accent}"/></Border>
     <Path x:Name="Spinner" Width="88" Height="88" Data="M 44,2 A 42,42 0 0 1 86,44" Stroke="{DynamicResource Accent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5" Visibility="{Binding UpdateBusy, Converter={StaticResource BoolVisibility}}"><Path.RenderTransform><RotateTransform x:Name="SpinnerRotation"/></Path.RenderTransform></Path>
    </Grid>
    <TextBlock Text="{Binding UpdateHeading}" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center"/>
    <Border Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="12,6" HorizontalAlignment="Center" Margin="0,12,0,18"><TextBlock Text="{Binding UpdateVersionChange}" Foreground="{DynamicResource Accent}" FontSize="12" FontWeight="SemiBold"/></Border>
    <StackPanel Visibility="{Binding UpdateOffer, Converter={StaticResource BoolVisibility}}">
     <ScrollViewer MaxHeight="134" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock Text="{Binding UpdateNotes}" Foreground="{DynamicResource Text}" TextWrapping="Wrap" FontSize="13" LineHeight="20" Margin="0,0,6,0"/></ScrollViewer>
     <Border Background="{DynamicResource Card}" CornerRadius="12" Padding="14" Margin="0,18,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition/></Grid.ColumnDefinitions><local:IconView Icon="Shield" Width="18" Height="18" Foreground="{DynamicResource Accent}" VerticalAlignment="Top"/><TextBlock Grid.Column="1" Text="{DynamicResource UpdateRestartHelp}" Style="{StaticResource Subtitle}" TextWrapping="Wrap" FontSize="12"/></Grid></Border>
    </StackPanel>
    <StackPanel Visibility="{Binding UpdateProgressVisible, Converter={StaticResource BoolVisibility}}">
     <Grid Margin="0,0,0,12" Visibility="{Binding UpdateFailed, Converter={StaticResource InverseBoolVisibility}}"><TextBlock Text="{Binding UpdateTransfer}" Style="{StaticResource Subtitle}" VerticalAlignment="Center"/><TextBlock Text="{Binding UpdatePercent, StringFormat={}{0}%}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Right"/></Grid>
     <ProgressBar x:Name="DownloadProgress" Height="8" Minimum="0" Maximum="100" Foreground="{DynamicResource AccentGradient}" Background="{DynamicResource Card}" Visibility="{Binding UpdateFailed, Converter={StaticResource InverseBoolVisibility}}" AutomationProperties.Name="{DynamicResource DownloadProgressLabel}"><ProgressBar.Template><ControlTemplate TargetType="ProgressBar"><Grid x:Name="PART_Track" ClipToBounds="True"><Border Background="{TemplateBinding Background}" CornerRadius="4"/><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="4"/></Grid></ControlTemplate></ProgressBar.Template></ProgressBar>
     <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Subtitle}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,15,0,0"/>
     <UniformGrid Columns="3" Margin="0,20,0,0" Visibility="{Binding UpdateFailed, Converter={StaticResource InverseBoolVisibility}}">
      <TextBlock Text="{DynamicResource UpdateStepDownload}" FontSize="11" Foreground="{DynamicResource Accent}" TextAlignment="Center"/>
      <TextBlock Text="{DynamicResource UpdateStepVerify}" FontSize="11" TextAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Style.Triggers><DataTrigger Binding="{Binding UpdatePercent}" Value="100"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <TextBlock Text="{DynamicResource UpdateStepRestart}" FontSize="11" TextAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Style.Triggers><DataTrigger Binding="{Binding UpdateStage}" Value="Restarting"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </UniformGrid>
    </StackPanel>
    <UniformGrid Columns="2" Margin="0,24,0,0" Visibility="{Binding UpdateBusy, Converter={StaticResource InverseBoolVisibility}}">
     <Button x:Name="LaterButton" Content="{DynamicResource UpdateLater}" Command="{Binding DeferUpdate}" Height="46" Margin="0,0,6,0"/>
     <Button x:Name="UpdateButton" Content="{DynamicResource UpdateNow}" Command="{Binding AcceptUpdate}" Style="{StaticResource AccentButton}" Height="46" Margin="6,0,0,0"/>
    </UniformGrid>
    <Button Content="{DynamicResource Cancel}" Command="{Binding CancelUpdate}" Visibility="{Binding UpdateBusy, Converter={StaticResource BoolVisibility}}" Margin="0,24,0,0" Height="46"/>
   </StackPanel>
  </Border>
 </Grid>
</UserControl>
