<UserControl x:Class="Bebekon.App.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{DynamicResource Settings}" Style="{StaticResource Heading}"/><TextBlock Text="{DynamicResource SettingsDetail}" Style="{StaticResource Subtitle}" Margin="0,0,0,22"/>
  <Border Style="{StaticResource CardStyle}"><StackPanel><Grid Margin="0,0,0,12"><TextBlock Text="{DynamicResource Language}" VerticalAlignment="Center"/><ComboBox HorizontalAlignment="Right" Width="180" SelectedValue="{Binding Settings.Language}" SelectedValuePath="Content"><ComboBoxItem Content="Русский"/><ComboBoxItem Content="English"/></ComboBox></Grid><CheckBox Content="{DynamicResource Startup}" IsChecked="{Binding Settings.StartWithWindows}"/><CheckBox Content="{DynamicResource Tray}" IsChecked="{Binding Settings.MinimizeToTray}"/><CheckBox Content="{DynamicResource AutoConnect}" IsChecked="{Binding Settings.AutoConnect}"/><CheckBox Content="{DynamicResource RestoreServer}" IsChecked="{Binding Settings.RestoreServer}"/><CheckBox Content="{DynamicResource Notifications}" IsChecked="{Binding Settings.Notifications}"/></StackPanel></Border>
  <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0"><StackPanel><CheckBox Content="{DynamicResource DnsProtection}" IsChecked="{Binding Settings.DnsProtection}" Margin="0,0,0,8"/><TextBlock Text="{DynamicResource DnsDetail}" Style="{StaticResource Subtitle}" TextWrapping="Wrap"/></StackPanel></Border>
  <Expander Header="{DynamicResource Advanced}" Margin="0,18,0,0"><Border Style="{StaticResource CardStyle}" Margin="0,14,0,0"><StackPanel><TextBlock Text="{Binding CoreVersion, StringFormat=sing-box {0} · Windows x64}" Foreground="{StaticResource Muted}"/><Grid Margin="0,12,0,10"><TextBlock Text="MTU" VerticalAlignment="Center"/><TextBox Text="{Binding Settings.Mtu}" Width="120" HorizontalAlignment="Right"/></Grid><CheckBox Content="{DynamicResource Compatibility}" IsChecked="{Binding Settings.CompatibilityMode}"/><TextBlock Text="{DynamicResource ProxyNote}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,12"/><WrapPanel><Button Content="{DynamicResource ConfigFolder}" Command="{Binding OpenConfig}" Margin="0,0,8,8"/><Button Content="{DynamicResource LogsFolder}" Command="{Binding OpenLogs}" Margin="0,0,8,8"/><Button Content="{DynamicResource RestartService}" Command="{Binding RestartService}" Margin="0,0,8,8"/></WrapPanel></StackPanel></Border></Expander>
  <Button Content="{DynamicResource SaveSettings}" Command="{Binding SaveSettings}" Style="{StaticResource AccentButton}" HorizontalAlignment="Right" Margin="0,18,0,0"/>
 </StackPanel></ScrollViewer>
</UserControl>
