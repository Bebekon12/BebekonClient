<UserControl x:Class="Bebekon.App.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Bebekon.App">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,22"><TextBlock Text="{DynamicResource Settings}" Style="{StaticResource Heading}"/><TextBlock Text="{DynamicResource SettingsDetail}" Style="{StaticResource Subtitle}"/></StackPanel>
  <TextBox x:Name="SettingsSearch" Grid.Row="1" Tag="{DynamicResource SearchSettings}" TextChanged="SearchChanged" Style="{StaticResource SearchBox}" Height="46" Margin="0,0,0,12"/>
  <WrapPanel Grid.Row="2" Margin="0,0,0,12">
   <RadioButton Tag="Updates" GroupName="SettingsCategory" Checked="CategoryChanged" Style="{StaticResource Chip}"><StackPanel Orientation="Horizontal"><local:IconView Icon="Download" Width="14" Height="14" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource AppUpdates}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0"/></StackPanel></RadioButton>
   <RadioButton Tag="Appearance" GroupName="SettingsCategory" Checked="CategoryChanged" Style="{StaticResource Chip}" ><StackPanel Orientation="Horizontal"><local:IconView Icon="Palette" Width="14" Height="14" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource Appearance}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0"/></StackPanel></RadioButton>
   <RadioButton Tag="Network" GroupName="SettingsCategory" Checked="CategoryChanged" Style="{StaticResource Chip}" IsChecked="True"><StackPanel Orientation="Horizontal"><local:IconView Icon="Network" Width="14" Height="14" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource Network}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0"/></StackPanel></RadioButton>
   <RadioButton Tag="Behavior" GroupName="SettingsCategory" Checked="CategoryChanged" Style="{StaticResource Chip}" ><StackPanel Orientation="Horizontal"><local:IconView Icon="Behavior" Width="14" Height="14" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource Behavior}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0"/></StackPanel></RadioButton>
   <RadioButton Tag="Advanced" GroupName="SettingsCategory" Checked="CategoryChanged" Style="{StaticResource Chip}" ><StackPanel Orientation="Horizontal"><local:IconView Icon="Settings" Width="14" Height="14" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource Advanced}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0"/></StackPanel></RadioButton>
   <RadioButton Tag="All" GroupName="SettingsCategory" Checked="CategoryChanged" Style="{StaticResource Chip}" ><StackPanel Orientation="Horizontal"><local:IconView Icon="List" Width="14" Height="14" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource AllSettings}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0"/></StackPanel></RadioButton>
  </WrapPanel>
  <Grid Grid.Row="3"><ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="SettingsRows" Margin="0,0,4,0">
    <local:SettingRow Category="Updates" Icon="Info" Title="{DynamicResource UpdateVersion}" Description="{DynamicResource UpdateVersionDetail}"><TextBlock Text="{Binding AppVersion}" Foreground="{DynamicResource Accent}" FontSize="16" FontWeight="SemiBold"/></local:SettingRow>
    <local:SettingRow Category="Updates" Icon="Refresh" Title="{DynamicResource AppUpdates}" Description="{Binding UpdateStatus}"><StackPanel Width="230"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{DynamicResource CheckUpdate}" Command="{Binding CheckUpdates}" Margin="0,3,6,3"/><Button Content="{DynamicResource Cancel}" Command="{Binding CancelUpdate}" Visibility="{Binding UpdateBusy, Converter={StaticResource BoolVisibility}}" Margin="0,3,0,3"/></StackPanel><Button Content="{DynamicResource InstallUpdate}" Command="{Binding InstallUpdate}" Visibility="{Binding UpdateVisibility}" Style="{StaticResource AccentButton}" Margin="0,3,0,3"/></StackPanel></local:SettingRow>
    <local:SettingRow Category="Updates" Icon="Download" Title="{DynamicResource AutoUpdates}" Description="{DynamicResource AutoUpdatesDetail}"><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AutoUpdates}" AutomationProperties.Name="{DynamicResource AutoUpdates}"/></local:SettingRow>
    <local:SettingRow Category="Updates" Icon="Folder" Title="{DynamicResource UpdateChannel}" Description="{Binding UpdateSourceLabel}"><Button Content="{DynamicResource ConfigureChannel}" Command="{Binding ConfigureUpdates}" ToolTip="{Binding UpdateSource}"/></local:SettingRow>
    <local:SettingRow Category="Network" Icon="Shield" Title="{DynamicResource TunMode}" Description="{DynamicResource TunDetail}"><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IsTunMode}" ToolTip="{DynamicResource TunMode}" AutomationProperties.Name="{DynamicResource TunMode}"/></local:SettingRow>
    <local:SettingRow Category="Network" Icon="Proxy" Title="{DynamicResource SystemProxy}" Description="{DynamicResource SystemProxyDetail}"><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IsProxyMode}" ToolTip="{DynamicResource SystemProxy}" AutomationProperties.Name="{DynamicResource SystemProxy}"/></local:SettingRow>
    <local:SettingRow Category="Network" Icon="Shield" Title="{DynamicResource DnsProtection}" Description="{DynamicResource DnsProtectionDetail}"><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.DnsProtection}" ToolTip="{DynamicResource DnsProtection}" AutomationProperties.Name="{DynamicResource DnsProtection}"/></local:SettingRow>
    <local:SettingRow Category="Network" Icon="Network" Title="{DynamicResource DnsResolver}" Description="{DynamicResource DnsDetail}"><Border Background="{DynamicResource AccentSoft}" CornerRadius="9" Padding="11,7"><TextBlock Text="DoH" Foreground="{DynamicResource Accent}" FontSize="12" FontWeight="SemiBold"/></Border></local:SettingRow>
    <local:SettingRow Category="Network" Icon="Behavior" Title="{DynamicResource HelperTitle}" Description="{DynamicResource HelperDetail}"><Button Content="{DynamicResource RestartShort}" Command="{Binding RestartService}"/></local:SettingRow>
    <local:SettingRow Category="Network" Icon="Monitor" Title="{DynamicResource Compatibility}" Description="{DynamicResource CompatibilityDetail}"><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.CompatibilityMode}" ToolTip="{DynamicResource Compatibility}" AutomationProperties.Name="{DynamicResource Compatibility}"/></local:SettingRow>
    <local:SettingRow Category="Appearance" Icon="Language" Title="{DynamicResource Language}" Description="{DynamicResource LanguageDetail}"><ComboBox Width="142" SelectedValue="{Binding Settings.Language}" SelectedValuePath="Content"><ComboBoxItem Content="Русский"/><ComboBoxItem Content="English"/></ComboBox></local:SettingRow>
    <local:SettingRow Category="Appearance" Icon="Palette" Title="{DynamicResource ThemeTitle}" Description="{DynamicResource ThemeDetail}"><Border Background="{DynamicResource AccentSoft}" CornerRadius="9" Padding="11,7"><TextBlock Text="{DynamicResource DarkTheme}" Foreground="{DynamicResource Accent}" FontSize="12"/></Border></local:SettingRow>
    <local:SettingRow Category="Appearance" Icon="Palette" Title="{DynamicResource AccentTitle}" Description="{DynamicResource AccentDetail}"><ComboBox Width="142" SelectedValue="{Binding AccentColor}" SelectedValuePath="Tag"><ComboBoxItem Tag="Cyan" Content="{DynamicResource Cyan}"/><ComboBoxItem Tag="Blue" Content="{DynamicResource Blue}"/><ComboBoxItem Tag="Emerald" Content="{DynamicResource Emerald}"/><ComboBoxItem Tag="Violet" Content="{DynamicResource Violet}"/></ComboBox></local:SettingRow>
    <local:SettingRow Category="Appearance" Icon="Sparkles" Title="{DynamicResource AnimationTitle}" Description="{DynamicResource AnimationDetail}"><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AnimationsEnabled}" AutomationProperties.Name="{DynamicResource AnimationTitle}"/></local:SettingRow>
    <local:SettingRow Category="Appearance" Icon="Power" Title="{DynamicResource GlowTitle}" Description="{DynamicResource GlowDetail}"><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding GlowEnabled}" AutomationProperties.Name="{DynamicResource GlowTitle}"/></local:SettingRow>
    <local:SettingRow Category="Appearance" Icon="Monitor" Title="{DynamicResource PureBlackTitle}" Description="{DynamicResource PureBlackDetail}"><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding PureBlack}" AutomationProperties.Name="{DynamicResource PureBlackTitle}"/></local:SettingRow>
    <local:SettingRow Category="Appearance" Icon="Servers" Title="Начало маршрута на карте" Description="Примерное местоположение по обычному IP через ipwho.is / ipapi.co. Без GPS; координаты не сохраняются."><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding MapLocationEnabled}" AutomationProperties.Name="Начало маршрута на карте"/></local:SettingRow>
    <local:SettingRow Category="Behavior" Icon="Power" Title="{DynamicResource Startup}" Description="{DynamicResource StartupDetail}"><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.StartWithWindows}" ToolTip="{DynamicResource Startup}" AutomationProperties.Name="{DynamicResource Startup}"/></local:SettingRow>
    <local:SettingRow Category="Behavior" Icon="Grid" Title="{DynamicResource Tray}" Description="{DynamicResource TrayDetail}"><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.MinimizeToTray}" ToolTip="{DynamicResource Tray}" AutomationProperties.Name="{DynamicResource Tray}"/></local:SettingRow>
    <local:SettingRow Category="Behavior" Icon="Bolt" Title="{DynamicResource AutoConnect}" Description="{DynamicResource AutoConnectDetail}"><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.AutoConnect}" ToolTip="{DynamicResource AutoConnect}" AutomationProperties.Name="{DynamicResource AutoConnect}"/></local:SettingRow>
    <local:SettingRow Category="Behavior" Icon="Servers" Title="{DynamicResource RestoreServer}" Description="{DynamicResource RestoreServerDetail}"><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.RestoreServer}" ToolTip="{DynamicResource RestoreServer}" AutomationProperties.Name="{DynamicResource RestoreServer}"/></local:SettingRow>
    <local:SettingRow Category="Behavior" Icon="Info" Title="{DynamicResource Notifications}" Description="{DynamicResource NotificationsDetail}"><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.Notifications}" ToolTip="{DynamicResource Notifications}" AutomationProperties.Name="{DynamicResource Notifications}"/></local:SettingRow>
    <local:SettingRow Category="Advanced" Icon="Network" Title="MTU" Description="{DynamicResource MtuDetail}"><TextBox Text="{Binding Settings.Mtu}" Width="84" MaxLength="4" TextAlignment="Center" AutomationProperties.Name="MTU"/></local:SettingRow>
    <local:SettingRow Category="Advanced" Icon="Folder" Title="{DynamicResource ConfigFolder}" Description="{DynamicResource ConfigDetail}"><Button Content="{DynamicResource Open}" Command="{Binding OpenConfig}"/></local:SettingRow>
    <local:SettingRow Category="Advanced" Icon="List" Title="{DynamicResource LogsTitle}" Description="{DynamicResource LogsDetail}"><Button Content="{DynamicResource Open}" Command="{Binding OpenLogs}"/></local:SettingRow>
    <local:SettingRow Category="Advanced" Icon="Info" Title="{DynamicResource CoreTitle}" Description="{DynamicResource CoreDetail}"><TextBlock Text="{Binding CoreVersion}" Foreground="{DynamicResource Accent}" FontSize="14" FontWeight="SemiBold"/></local:SettingRow>
  </StackPanel></ScrollViewer><StackPanel x:Name="NoSettingsFound" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center"><local:IconView Icon="Search" Width="36" Height="36" Foreground="{DynamicResource Muted}" Margin="0,0,0,14"/><TextBlock Text="{DynamicResource NothingFound}" FontSize="17"/><TextBlock Text="{DynamicResource TrySearch}" Style="{StaticResource Subtitle}" Margin="0,6,0,0"/></StackPanel></Grid>
  <Grid Grid.Row="4" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource SaveDetail}" Style="{StaticResource Subtitle}" TextWrapping="Wrap" MaxWidth="350" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,18,0"/><Button Grid.Column="1" Content="{DynamicResource SaveSettings}" Command="{Binding SaveSettings}" Style="{StaticResource AccentButton}" MinWidth="182"/></Grid>
 </Grid>
</UserControl>
