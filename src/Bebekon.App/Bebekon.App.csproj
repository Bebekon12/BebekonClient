<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>../../resources/icons/bebekon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../resources/updates/public-key.xml" LogicalName="Bebekon.UpdateKey" />
    <EmbeddedResource Include="../../android/app/src/main/assets/world.json" LogicalName="Bebekon.World.json" />
    <Using Remove="System.Drawing"/><Using Remove="System.Windows.Forms"/>
    <ProjectReference Include="../Bebekon.Core/Bebekon.Core.csproj" />
    <Content Include="../../resources/presets/services.json" Link="resources/services.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../core/xray.exe" Link="core/xray.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../core/trusttunnel_client.exe" Link="core/trusttunnel_client.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../core/sing-box.exe" Link="core/sing-box.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../resources/icons/bebekon.ico" Link="resources/bebekon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="../../resources/icons/snowman.png" Link="resources/snowman.png" />
    <Resource Include="../../resources/design/night-track.png" Link="resources/night-track.png" />
    <Content Include="../../resources/flags/*.png" Link="resources/flags/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
