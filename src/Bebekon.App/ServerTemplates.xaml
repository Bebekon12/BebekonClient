<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Bebekon.App">
 <local:SelectionConverter x:Key="Selection"/>
  <DataTemplate x:Key="ServerCard">
   <Border x:Name="ServerSurface" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="11" MinHeight="62"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource Card}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource CardHover}"/></Trigger></Style.Triggers></Style></Border.Style><Grid>
    <Button Command="{Binding DataContext.SelectServer, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource DockButton}" Padding="16,11" Background="Transparent"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="154"/></Grid.ColumnDefinitions>
     <local:FlagView Country="{Binding Name}" Width="30" Height="22" VerticalAlignment="Center"/>
     <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayName}" FontSize="14" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/><TextBlock x:Name="ProtocolLabel" Text="{Binding ConnectionLabel}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
     <TextBlock Grid.Column="2" Text="{Binding Protocol}" FontSize="11" Foreground="{DynamicResource Muted}" Width="132" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Visibility="{Binding DataContext.ListMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVisibility}}"/>
    </Grid></Button>
    <Button Command="{Binding DataContext.ConfigureTrustTunnel, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Visibility="{Binding IsTrustTunnel, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,128,0" Style="{StaticResource QuietIconButton}" ToolTip="TrustTunnel · HTTP/2 / HTTP/3"><local:IconView Icon="Settings" Width="17" Height="17"/></Button>
    <Button Command="{Binding DataContext.PingServer, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,42,0" Width="84" Height="36" MinHeight="36" Padding="2,0" Background="Transparent" BorderThickness="0" Style="{StaticResource PingButton}" ToolTip="{DynamicResource PingAgain}"><TextBlock Text="{Binding Latency}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Foreground="{Binding LatencyQuality, Converter={StaticResource LatencyBrush}}" FontSize="12"/></Button>
    <Button Command="{Binding DataContext.FavoriteServer, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Избранное"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuietIconButton}"><Style.Triggers><DataTrigger Binding="{Binding Favorite}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style><local:IconView Icon="Star" Width="18" Height="18"/></Button>
   </Grid><Border.ToolTip><TextBlock Text="{Binding UnsupportedReason}"/></Border.ToolTip></Border>
   <DataTemplate.Triggers><DataTrigger Binding="{Binding DataContext.ListMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter TargetName="ProtocolLabel" Property="Text" Value="{Binding SubscriptionLabel}"/></DataTrigger><DataTrigger Value="True"><DataTrigger.Binding><MultiBinding Converter="{StaticResource Selection}"><Binding/><Binding Path="DataContext.SelectedServer" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></DataTrigger.Binding><Setter TargetName="ServerSurface" Property="BorderBrush" Value="{DynamicResource AccentBorder}"/><Setter TargetName="ServerSurface" Property="Background" Value="{DynamicResource FeatureGradient}"/></DataTrigger><DataTrigger Binding="{Binding Supported}" Value="False"><Setter TargetName="ServerSurface" Property="Opacity" Value="0.65"/><Setter TargetName="ProtocolLabel" Property="Text" Value="{DynamicResource Unsupported}"/><Setter TargetName="ProtocolLabel" Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger></DataTemplate.Triggers>
  </DataTemplate>

 <DataTemplate DataType="{x:Type local:ServerRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="{Binding DataContext.SecondColumn, RelativeSource={RelativeSource AncestorType=UserControl}}"/></Grid.ColumnDefinitions><ContentControl Content="{Binding Left}" ContentTemplate="{StaticResource ServerCard}"><ContentControl.Style><Style TargetType="ContentControl"><Setter Property="Margin" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.ListMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"><Setter Property="Margin" Value="0,0,7,0"/></DataTrigger></Style.Triggers></Style></ContentControl.Style></ContentControl><ContentControl Grid.Column="1" Content="{Binding Right}" ContentTemplate="{StaticResource ServerCard}" Margin="7,0,0,0"><ContentControl.Style><Style TargetType="ContentControl"><Style.Triggers><DataTrigger Binding="{Binding Right}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ContentControl.Style></ContentControl></Grid></DataTemplate>
</ResourceDictionary>
